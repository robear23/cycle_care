TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Telegram bot username (without @), used for t.me links
TELEGRAM_BOT_USERNAME=cycle_care_bot

# Optional: receive updates by webhook instead of polling. Still run one instance (chat state is in memory).
# Public base URL of this app; the bot registers <url>/webhook/telegram on startup.
TELEGRAM_WEBHOOK_URL=
# Random string (A-Z, a-z, 0-9, _ and -) Telegram sends back on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# Public URL of the website, no trailing slash (used for social previews and the /help privacy link)
PUBLIC_SITE_URL=https://cyclecare.foresttechsolutions.net

# Number of reverse proxies in front of the app (1 on Railway/Render/Heroku), so rate limits see real IPs
TRUST_PROXY=1

# Resend API key for welcome and follow-up emails (emails are skipped if unset)
RESEND_API_KEY=

DATABASE_URL="postgresql://postgres:password@localhost:5432/cyclecare?schema=public"
PORT=3000
NODE_ENV=development
