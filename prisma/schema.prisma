generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  telegram_chat_id  String   @unique
  partner_name      String?
  cycle_start_date  DateTime
  cycle_length      Int      @default(28)
  cycle_length_min  Int?
  cycle_length_max  Int?
  period_duration   Int      @default(5)
  notification_time String   @default("08:00")
  timezone          String   @default("UTC")
  subscription_status String @default("active") // active, paused, cancelled
  referral_code     String?  @unique
  referred_by       String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  message_logs      MessageLog[]
}

model Message {
  id            Int      @id @default(autoincrement())
  phase         String   // menstrual, follicular, ovulation, luteal, general
  message_text  String
  tone          String?  // supportive, energetic, romantic, calm
  created_at    DateTime @default(now())
  message_logs  MessageLog[]
}

model MessageLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  message_id Int
  message    Message  @relation(fields: [message_id], references: [id])
  sent_at    DateTime @default(now())
}

model WaitlistLead {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  created_at DateTime @default(now())
}
